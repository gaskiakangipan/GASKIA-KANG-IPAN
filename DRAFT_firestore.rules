rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'gaskiakangipan@gmail.com'
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'role', 'organizationId', 'jobTitle', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'role', 'organizationId', 'jobTitle', 'avatarUrl', 'status', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role is string && data.role.size() <= 32 && (data.role == 'participant' || data.role == 'instructor' || data.role == 'org_admin' || data.role == 'superadmin') &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 && data.organizationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.jobTitle is string && data.jobTitle.size() <= 100 &&
        (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
        data.status is string && data.status.size() <= 32 && (data.status == 'active' || data.status == 'suspended') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['ownerId', 'email', 'notificationEmail', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'email', 'notificationEmail', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.notificationEmail is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAssessmentActivity(data) {
      return data.keys().hasAll(['ownerId', 'organizationId', 'title', 'assessmentType', 'status', 'accessCode', 'durationMinutes', 'passingScore', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'organizationId', 'title', 'assessmentType', 'status', 'accessCode', 'durationMinutes', 'passingScore', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 && data.organizationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.assessmentType is string && data.assessmentType.size() <= 32 &&
        (data.assessmentType == 'pretest' || data.assessmentType == 'posttest' || data.assessmentType == 'paired' || data.assessmentType == 'single' || data.assessmentType == 'quiz' || data.assessmentType == 'periodic') &&
        data.status is string && data.status.size() <= 32 &&
        (data.status == 'draft' || data.status == 'ready' || data.status == 'scheduled' || data.status == 'ongoing' || data.status == 'completed' || data.status == 'archived') &&
        data.accessCode is string && data.accessCode.size() >= 1 && data.accessCode.size() <= 32 && data.accessCode.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
        data.passingScore is int && data.passingScore >= 0 && data.passingScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidQuestionItem(data) {
      return data.keys().hasAll(['ownerId', 'organizationId', 'prompt', 'questionType', 'category', 'difficulty', 'points', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'organizationId', 'prompt', 'questionType', 'category', 'difficulty', 'points', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 && data.organizationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
        data.questionType is string && data.questionType.size() <= 32 &&
        (data.questionType == 'single_choice' || data.questionType == 'multiple_choice' || data.questionType == 'true_false' || data.questionType == 'short_answer' || data.questionType == 'numeric' || data.questionType == 'matching' || data.questionType == 'ordering' || data.questionType == 'essay' || data.questionType == 'image_question' || data.questionType == 'stimulus_case') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.difficulty is string && data.difficulty.size() <= 32 && (data.difficulty == 'mudah' || data.difficulty == 'sedang' || data.difficulty == 'sulit') &&
        data.points is int && data.points >= 1 && data.points <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAssessmentAttempt(data) {
      return data.keys().hasAll(['participantId', 'assessmentId', 'status', 'objectiveScore', 'finalScore', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['participantId', 'assessmentId', 'status', 'objectiveScore', 'finalScore', 'createdAt', 'updatedAt']) &&
        data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 128 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.assessmentId is string && data.assessmentId.size() >= 1 && data.assessmentId.size() <= 128 && data.assessmentId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.status is string && data.status.size() <= 32 && (data.status == 'in_progress' || data.status == 'submitted' || data.status == 'graded') &&
        data.objectiveScore is int && data.objectiveScore >= 0 && data.objectiveScore <= 100 &&
        data.finalScore is int && data.finalScore >= 0 && data.finalScore <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && existing().uid == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        (incoming().role == 'participant' || incoming().role == 'instructor') &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().organizationId == existing().organizationId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'jobTitle', 'avatarUrl', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(userId);

      match /private/{docId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) &&
          (request.auth.uid == userId || isAdmin()) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          request.auth.uid == userId &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == userId &&
          (
            (request.auth.uid == userId &&
              incoming().email == existing().email &&
              incoming().diff(existing()).affectedKeys().hasOnly(['notificationEmail', 'updatedAt'])
            ) ||
            isAdmin()
          );
        allow delete: if isAdmin() && isValidId(userId) && isValidId(docId);
      }
    }

    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && isValidId(assessmentId) && (existing().ownerId == request.auth.uid || existing().status != 'draft' || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(assessmentId) &&
        isValidAssessmentActivity(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(assessmentId) &&
        isValidAssessmentActivity(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (existing().ownerId == request.auth.uid &&
            existing().status != 'completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'assessmentType', 'status', 'accessCode', 'durationMinutes', 'passingScore', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() && isValidId(assessmentId) && ((existing().ownerId == request.auth.uid && existing().status == 'draft') || isAdmin());
    }

    match /questions/{questionId} {
      allow get: if isSignedIn() && isValidId(questionId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidQuestionItem(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(questionId) &&
        isValidQuestionItem(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'questionType', 'category', 'difficulty', 'points', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isVerifiedUser() && isValidId(questionId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /attempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && (existing().participantId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && existing().participantId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidAssessmentAttempt(incoming()) &&
        incoming().participantId == request.auth.uid &&
        incoming().status == 'in_progress' &&
        incoming().objectiveScore == 0 &&
        incoming().finalScore == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/assessments/$(incoming().assessmentId));
      allow update: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidAssessmentAttempt(incoming()) &&
        incoming().participantId == existing().participantId &&
        incoming().assessmentId == existing().assessmentId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (existing().participantId == request.auth.uid &&
            existing().status != 'graded' &&
            incoming().status == 'submitted' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'objectiveScore', 'finalScore', 'updatedAt'])
          ) ||
          isAdmin()
        );
      allow delete: if isAdmin() && isValidId(attemptId);
    }
  }
}
